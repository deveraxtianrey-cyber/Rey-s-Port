rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to send a message through the contact form
    match /messages/{message} {
      // Relaxed rules for debugging - allow create if all keys are present
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'timestamp']);
      
      // Prevent anyone from reading, updating or deleting messages
      allow read, update, delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
